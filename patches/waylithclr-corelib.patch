+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+using System.Diagnostics.CodeAnalysis;
+using System.Runtime.CompilerServices;
+
+namespace System.Runtime.CompilerServices
+{
+    // Port17: publicizer-based Framework mods call Mono's bit-preserving enum casts. Keep the
+    // small integral widths exact, including unsigned-to-wide sign extension behavior.
+    [ExcludeFromCodeCoverage]
+    public static class JitHelpers
+    {
+        public static int UnsafeEnumCast<T>(T value) where T : struct
+        {
+            Type underlyingType = typeof(T).IsEnum ? Enum.GetUnderlyingType(typeof(T)) : typeof(T);
+            return underlyingType switch
+            {
+                _ when underlyingType == typeof(sbyte) => Unsafe.BitCast<T, sbyte>(value),
+                _ when underlyingType == typeof(byte) => Unsafe.BitCast<T, byte>(value),
+                _ when underlyingType == typeof(short) => Unsafe.BitCast<T, short>(value),
+                _ when underlyingType == typeof(ushort) => Unsafe.BitCast<T, ushort>(value),
+                _ when underlyingType == typeof(uint) => unchecked((int)Unsafe.BitCast<T, uint>(value)),
+                _ when underlyingType == typeof(long) => unchecked((int)Unsafe.BitCast<T, long>(value)),
+                _ when underlyingType == typeof(ulong) => unchecked((int)Unsafe.BitCast<T, ulong>(value)),
+                _ => Unsafe.BitCast<T, int>(value),
+            };
+        }
+
+        public static long UnsafeEnumCastLong<T>(T value) where T : struct
+        {
+            Type underlyingType = typeof(T).IsEnum ? Enum.GetUnderlyingType(typeof(T)) : typeof(T);
+            return underlyingType switch
+            {
+                _ when underlyingType == typeof(sbyte) => Unsafe.BitCast<T, sbyte>(value),
+                _ when underlyingType == typeof(byte) => Unsafe.BitCast<T, byte>(value),
+                _ when underlyingType == typeof(short) => Unsafe.BitCast<T, short>(value),
+                _ when underlyingType == typeof(ushort) => Unsafe.BitCast<T, ushort>(value),
+                _ when underlyingType == typeof(int) => Unsafe.BitCast<T, int>(value),
+                _ when underlyingType == typeof(uint) => Unsafe.BitCast<T, uint>(value),
+                _ when underlyingType == typeof(ulong) => unchecked((long)Unsafe.BitCast<T, ulong>(value)),
+                _ => Unsafe.BitCast<T, long>(value),
+            };
+        }
+    }
+}
