+#if !defined(HOST_OSX)
+// The iOS SDK marks pthread_jit_write_protect_np as unavailable, but the
+// symbol exists in libsystem_pthread.dylib; JIT-enabled processes may resolve
+// it dynamically. Used only by JIT builds with an active JIT grant.
+#include <dlfcn.h>
+static void port17_jit_write_protect(int enabled)
+{
+    static void (*fn)(int) = (void (*)(int))dlsym(RTLD_DEFAULT, "pthread_jit_write_protect_np");
+    if (fn != NULL)
+    {
+        fn(enabled);
+    }
+}
+#define pthread_jit_write_protect_np port17_jit_write_protect
+#endif
