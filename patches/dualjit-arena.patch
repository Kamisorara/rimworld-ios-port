 void *VMToOSInterface::CommitDoubleMappedMemory(void* pStart, size_t size, bool isExecutable)
 {
+#if defined(TARGET_APPLE) && defined(TARGET_ARM64)
+    // Arena mode: the execution view flips between RX (code pages) and RW
+    // (loader-heap data pages that must stay near the code). Single-mapping
+    // mode keeps code pages RWX so writes through the shared view keep working.
+    int protection;
+    if (s_rw17Mapper != NULL && s_rw17Mapper->singleMapping)
+    {
+        protection = isExecutable ? (PROT_READ | PROT_WRITE | PROT_EXEC) : (PROT_READ | PROT_WRITE);
+    }
+    else
+    {
+        protection = isExecutable ? (PROT_READ | PROT_EXEC) : (PROT_READ | PROT_WRITE);
+    }
+    if (mprotect(pStart, size, protection) == -1)
+    {
+        RW17_LOG("commit flip of %p (%llu bytes, %s) failed (errno=%d)\n",
+                 pStart, (unsigned long long)size, isExecutable ? "rx" : "rw", errno);
+        return NULL;
+    }
+
+    return pStart;
+#else
     if (mprotect(pStart, size, isExecutable ? (PROT_READ | PROT_EXEC) : (PROT_READ | PROT_WRITE)) == -1)
     {
         return NULL;
     }
 
     return pStart;
+#endif // TARGET_ARM64
 }
 
