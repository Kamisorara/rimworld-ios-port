+
+// ---------------------------------------------------------------------------
+// Port17 JIT26 backend (iOS device / macOS CI), playport-shaped: a
+// synchronous brk handshake with an early detach.
+//
+// iOS does not export pthread_jit_write_protect_np, so a MAP_JIT mapping can
+// never be made writable in-process; iOS 26+ additionally refuses to execute
+// self-created RWX mappings. Executable memory is granted only through a
+// debugger, so on iOS the runtime ASKS for it instead of scanning for it:
+//
+//   Rw17Jit26PrepareRegion(len)   mov x16, #1 ; brk #0xf00d ; ret
+//   Rw17Jit26Detach()             mov x16, #0 ; brk #0xf00d ; ret
+//
+// The StikDebug serve script (probe/stikdebug/rw17-jit26.js) catches each
+// brk, skips it, allocates the requested bytes RX with the private "_M,rx"
+// packet, writes one byte to every 16 KiB page of it (the blessing that
+// keeps the pages executable once the debugger is gone) and returns the
+// address in x0; for a detach it sends "D" and the session ends - the
+// script window can be closed. The runtime maps one vm_remap RW alias for
+// writing, executes through the granted RX view, and DETACHES BEFORE
+// ANYTHING EXECUTES. That ordering is the fix for the probe-window freeze
+// of the scan-based design: while a debugserver session is attached, Mach
+// exceptions reach the debugger first, a faulting instruction stops the
+// process, and in-process handlers (the sigsetjmp probe below, later
+// CoreCLR's own exception dispatch on every managed exception) never run -
+// the process only stop/continue-loops under the script. Detached, the
+// probe below runs normally, and startup owns its faults.
+//
+// A brk with nobody behind it is SIGTRAP and death, so every brk is gated:
+// CS_DEBUGGED (csops) plus P_TRACED (sysctl kern.proc.pid) checked
+// immediately before issuing it; short or failed queries fail closed. The
+// gate waits up to 120 s for the user to run the serve script (progress in
+// stderr every 15 s, surfaced by the host's log dump), then fails cleanly:
+// coreclr_initialize reports it and stderr says to launch via StikDebug
+// with rw17-jit26.js.
+//
+// macOS has no StikDebug; it keeps the previous flow for CI coverage: the
+// seeded-arena scan below (macprobe-osx with RW17_SEED_ARENA=1 exercises
+// the alias/probe/Commit machinery through the same Rw17MapAliasRW /
+// Rw17ProbeExecute / Reserve / Commit code the device uses) and, with no
+// seed, the self-allocated RWX arena. The iOS simulator likewise never
+// issues a brk: nothing serves it there, and CI expects a fast clean
+// degrade.
+// ---------------------------------------------------------------------------
+
+// 16-byte magic without NUL; the array keeps one extra byte for the C++ rule
+// that forbids truncating string initializers. Only the macOS seeded-arena
+// path (and the CI harness stamping it) references it.
+static const char s_rw17ArenaMagic[17] = "RW17-JIT-ARENA1!";
+static const size_t Rw17ArenaMagicLen = sizeof(s_rw17ArenaMagic) - 1; // == 16
+
+static const size_t Rw17ArenaCapacity = 0x8000000;  // 128 MiB; keep in sync with rw17-jit26.js (the brk carries it in x1)
+static const size_t Rw17ArenaPageSize = 0x4000;     // arm64 Apple device page size
+static const size_t Rw17ArenaHeaderSize = 0x4000;   // seeded/self arenas: page 0 holds the handshake header; brk arenas skip nothing
+
+#ifndef P_TRACED
+#define P_TRACED 0x00000800
+#endif
+
+struct Rw17ArenaMapper
+{
+    uint8_t* rxBase;        // execution view (debugger-granted, RX as granted)
+    uint8_t* rwBase;        // write view; == rxBase in single-mapping mode
+    size_t capacity;
+    size_t headerSize;      // 0x4000 for seeded/self arenas (handshake page), 0 for brk-granted
+    bool singleMapping;     // self-allocated RWX arena: no aliases
+};
+
+static Rw17ArenaMapper* s_rw17Mapper = NULL;
+
+#define RW17_LOG(...) do { fprintf(stderr, "[rw17-arena] " __VA_ARGS__); } while (0)
+
+// The slim Apple SDKs ship neither <sys/codesign.h> nor the CS_* values (the
+// csops syscall itself lives in libSystem), so the gate declares what it
+// needs locally - values per XNU's cs_builtins.h.
+#ifndef CS_OPS_STATUS
+#define CS_OPS_STATUS 0
+#endif
+#ifndef CS_DEBUGGED
+#define CS_DEBUGGED 0x10000000 // set at debugger launch/attach; survives a detach
+#endif
+extern "C" int csops(pid_t pid, unsigned int ops, void* useraddr, size_t usersize);
+
+// CS_DEBUGGED and P_TRACED, both, or nothing. CS_DEBUGGED survives a detach
+// (playport's wine_host.c lesson: it is launch state, not liveness); P_TRACED
+// is the live-tracer bit. A short or failed query is "no debugger" - an
+// unserved brk kills the process, so the gate fails closed.
+static bool Rw17DebuggerAttached()
+{
+    const pid_t pid = getpid();
+    uint32_t flags = 0;
+    if (csops(pid, CS_OPS_STATUS, &flags, sizeof(flags)) != 0 || !(flags & CS_DEBUGGED))
+    {
+        return false;
+    }
+    int mib[4] = { CTL_KERN, KERN_PROC, KERN_PROC_PID, pid };
+    struct kinfo_proc info;
+    size_t size = sizeof(info);
+    memset(&info, 0, sizeof(info));
+    if (sysctl(mib, 4, &info, &size, NULL, 0) != 0 || size != sizeof(info))
+    {
+        return false;
+    }
+    return (info.kp_proc.p_flag & P_TRACED) != 0;
+}
+
+// The app asks for the region by trapping; the serve script has debugserver
+// allocate it RX and bless every page, and answers with the address in x0.
+// The parameter is unnamed on purpose: the ABI carries it in x1 for the
+// script to read, and a naked function has no body to silence a warning in.
+__attribute__((noinline, optnone, naked)) static void* Rw17Jit26PrepareRegion(size_t)
+{
+    __asm__("mov x16, #1\n"
+            "brk #0xf00d\n"
+            "ret\n");
+}
+
+__attribute__((noinline, optnone, naked)) static void Rw17Jit26Detach()
+{
+    __asm__("mov x16, #0\n"
+            "brk #0xf00d\n"
+            "ret\n");
+}
+
+// Read the 20-byte handshake header (magic + pid) at the start of a region.
+static bool Rw17ReadArenaHeader(void* regionStart, uint32_t* pPid)
+{
+    const size_t headerSize = Rw17ArenaMagicLen + sizeof(uint32_t);
+    uint8_t buffer[Rw17ArenaMagicLen + sizeof(uint32_t)];
+    vm_size_t bytesRead = 0;
+    kern_return_t kr = vm_read_overwrite(mach_task_self(), (vm_address_t)regionStart, headerSize,
+                                         (vm_address_t)buffer, &bytesRead);
+    if (kr != KERN_SUCCESS || bytesRead != headerSize)
+    {
+        return false;
+    }
+    if (memcmp(buffer, s_rw17ArenaMagic, Rw17ArenaMagicLen) != 0)
+    {
+        return false;
+    }
+    uint32_t pid;
+    memcpy(&pid, buffer + Rw17ArenaMagicLen, sizeof(pid));
+    *pPid = pid;
+    return true;
+}
+
+// macOS-only: walk the VM regions and return the RX arena the CI harness
+// stamped (magic + pid at offset 0, page 0). Never used on iOS - the brk
+// handshake replaced the scan there, and a scan cannot prove liveness.
+static void* Rw17FindArena()
+{
+    mach_port_t task = mach_task_self();
+    const uint32_t pid = getpid();
+    vm_address_t address = 0;
+    unsigned regionsWalked = 0;
+    for (;;)
+    {
+        regionsWalked++;
+        // <mach/mach_vm.h> is blocked in the iOS SDK; vm_region_64 is the same facility.
+        vm_region_basic_info_data_64_t info;
+        mach_msg_type_number_t infoCount = VM_REGION_BASIC_INFO_COUNT_64;
+        mach_port_t objectName = MACH_PORT_NULL;
+        vm_size_t regionSize = 0;
+        kern_return_t kr = vm_region_64(task, &address, &regionSize, VM_REGION_BASIC_INFO_64,
+                                        (vm_region_info_t)&info, &infoCount, &objectName);
+        if (kr != KERN_SUCCESS || regionSize == 0)
+        {
+            break;
+        }
+        if (objectName != MACH_PORT_NULL)
+        {
+            mach_port_deallocate(task, objectName);
+        }
+        if ((info.protection & VM_PROT_EXECUTE) && !(info.protection & VM_PROT_WRITE) &&
+            regionSize >= Rw17ArenaPageSize)
+        {
+            uint32_t pidInHeader = 0;
+            if (Rw17ReadArenaHeader((void*)address, &pidInHeader))
+            {
+                if (pidInHeader == pid)
+                {
+                    RW17_LOG("arena found at %p (%llu bytes, pid %u)\n",
+                             (void*)address, (unsigned long long)regionSize, pidInHeader);
+                    return (void*)address;
+                }
+                RW17_LOG("arena header pid %u does not match this process (%u); skipping\n",
+                         pidInHeader, pid);
+            }
+        }
+        vm_address_t next = address + regionSize;
+        if (next <= address)
+        {
+            break; // wrapped around the address space
+        }
+        address = next;
+    }
+    RW17_LOG("scan finished: %u VM regions walked, no matching arena\n", regionsWalked);
+    return NULL;
+}
+
+static sigjmp_buf s_rw17ProbeJmp;
+static volatile sig_atomic_t s_rw17ProbeFaulted;
+
+static void Rw17ProbeFaultHandler(int sig, siginfo_t* info, void* context)
+{
+    (void)context;
+    s_rw17ProbeFaulted = 1;
+    RW17_LOG("probe fault (sig=%d, fault address %p) - reported as clean failure\n",
+             sig, info != NULL ? info->si_addr : NULL);
+    siglongjmp(s_rw17ProbeJmp, 1);
+}
+
+// Verify the (rw, rx) view pair executes self-written code: two instruction
+// writes through the RW view, each flushed on both views, each called via RX.
+// A fault during the probe (code signing rejection, non-writable alias, ...)
+// is caught by a temporary handler and reported as a clean false - the probe
+// must never kill the process (same pattern as STS2's executeProbe). This
+// only works AFTER the detach: with a debugger attached the fault stops the
+// process before any in-process handler can run.
+static bool Rw17ProbeExecute(uint8_t* rxView, uint8_t* rwView)
+{
+    struct sigaction faultAction;
+    memset(&faultAction, 0, sizeof(faultAction));
+    faultAction.sa_sigaction = Rw17ProbeFaultHandler;
+    faultAction.sa_flags = SA_SIGINFO;
+    sigemptyset(&faultAction.sa_mask);
+    struct sigaction oldBus, oldSegv, oldIll;
+    if (sigaction(SIGBUS, &faultAction, &oldBus) != 0 ||
+        sigaction(SIGSEGV, &faultAction, &oldSegv) != 0 ||
+        sigaction(SIGILL, &faultAction, &oldIll) != 0)
+    {
+        RW17_LOG("cannot install probe fault handlers (errno=%d)\n", errno);
+        return false;
+    }
+
+    const uint32_t kGadget42[2] = { 0x52800540u, 0xD65F03C0u }; // movz w0, #42 ; ret
+    const uint32_t kGadget43Word = 0x52800560u;                 // movz w0, #43
+    bool ok = false;
+    s_rw17ProbeFaulted = 0;
+    if (sigsetjmp(s_rw17ProbeJmp, 1) == 0)
+    {
+        memcpy(rwView, kGadget42, sizeof(kGadget42));
+        sys_icache_invalidate(rwView, sizeof(kGadget42));
+        sys_icache_invalidate(rxView, sizeof(kGadget42));
+
+        // STS2 ready_v1 compares the two views before executing: the alias
+        // write must be visible through the granted arena (physical-page
+        // coherence), otherwise executing the arena would run stale bytes.
+        uint32_t viaAlias = 0, viaArena = 0;
+        memcpy(&viaAlias, rwView, sizeof(viaAlias));
+        memcpy(&viaArena, rxView, sizeof(viaArena));
+        RW17_LOG("probe bytes: alias=%08x arena=%08x (expect 52800540 both)\n", viaAlias, viaArena);
+
+        int32_t (*probe)(void) = (int32_t (*)(void))rxView;
+        int32_t r1 = probe();
+        RW17_LOG("probe call #1 -> %d (expect 42)\n", r1);
+        if (r1 == 42)
+        {
+            memcpy(rwView, &kGadget43Word, sizeof(kGadget43Word));
+            sys_icache_invalidate(rwView, sizeof(kGadget43Word));
+            sys_icache_invalidate(rxView, sizeof(kGadget43Word));
+            int32_t r2 = probe();
+            RW17_LOG("probe call #2 -> %d (expect 43)\n", r2);
+            ok = (r2 == 43);
+        }
+    }
+
+    sigaction(SIGBUS, &oldBus, NULL);
+    sigaction(SIGSEGV, &oldSegv, NULL);
+    sigaction(SIGILL, &oldIll, NULL);
+    if (s_rw17ProbeFaulted)
+    {
+        return false;
+    }
+    return ok;
+}
+
+// Create an RW alias of [source, source+size): remap the same physical pages
+// and drop EXEC on the alias. Aliasing debugger-created pages bypasses the
+// W^X provenance check that blocks a direct mprotect of the arena itself.
+// BSD mprotect first, then vm_protect (the Mach-semantics wrapper, declared
+// in the same header as vm_remap; the playport reference protects through
+// the Mach path - on some iOS builds the BSD path refuses the very change
+// the Mach one grants). Every failure logs its exact code; this stretch was
+// once a silent one.
+static uint8_t* Rw17MapAliasRW(void* source, size_t size)
+{
+    vm_address_t alias = 0;
+    vm_prot_t curProtection = VM_PROT_NONE, maxProtection = VM_PROT_NONE;
+    kern_return_t kr = vm_remap(mach_task_self(), &alias, size, 0, VM_FLAGS_ANYWHERE,
+                                mach_task_self(), (vm_address_t)source, FALSE,
+                                &curProtection, &maxProtection, VM_INHERIT_NONE);
+    if (kr != KERN_SUCCESS)
+    {
+        RW17_LOG("vm_remap of the arena failed: kr=%d (0x%x)\n", (int)kr, (unsigned)kr);
+        return NULL;
+    }
+    RW17_LOG("alias at %p (cur=%x max=%x straight from the remap)\n",
+             (void*)alias, (unsigned)curProtection, (unsigned)maxProtection);
+    if (mprotect((void*)alias, size, PROT_READ | PROT_WRITE) == 0)
+    {
+        return (uint8_t*)alias;
+    }
+    RW17_LOG("mprotect RW on the alias failed: errno=%d - trying vm_protect (Mach path)\n", errno);
+    kr = vm_protect(mach_task_self(), alias, size, FALSE, VM_PROT_READ | VM_PROT_WRITE);
+    if (kr == KERN_SUCCESS)
+    {
+        return (uint8_t*)alias;
+    }
+    RW17_LOG("vm_protect RW on the alias failed too: kr=%d (0x%x)\n", (int)kr, (unsigned)kr);
+    vm_deallocate(mach_task_self(), alias, size);
+    return NULL;
+}
+
+// Wait for the serving script. iOS device only: macOS and the iOS simulator
+// never brk (macOS has the seeded scan and the RWX fallback below; the
+// simulator must degrade fast because nothing serves it there).
+// VALUE test, not defined(): TargetConditionals.h defines TARGET_OS_SIMULATOR
+// unconditionally (to 0 on device!), so defined() once sent a real device
+// down the simulator's instant-degrade path.
+static bool Rw17WaitForDebugger(int waitMs)
+{
+#if TARGET_OSX || TARGET_OS_SIMULATOR
+    (void)waitMs;
+    return false;
+#else
+    RW17_LOG("waiting for a live debugger - launch via StikDebug and run probe/stikdebug/rw17-jit26.js (%d s budget)\n", waitMs / 1000);
+    int waited = 0;
+    while (!Rw17DebuggerAttached())
+    {
+        if (waited >= waitMs)
+        {
+            RW17_LOG("no live debugger after %d s; no usable JIT memory\n", waitMs / 1000);
+            return false;
+        }
+        struct timespec ts = { 0, 50 * 1000 * 1000 }; // 50 ms
+        nanosleep(&ts, NULL);
+        waited += 50;
+        if (waited % (15 * 1000) == 0)
+        {
+            RW17_LOG("still waiting for a live debugger (%d/%d s)\n", waited / 1000, waitMs / 1000);
+        }
+    }
+    return true;
+#endif
+}
+
+static bool Rw17CreateArenaMapper(void** pHandle, size_t* pMaxExecutableCodeSize)
+{
+    Rw17ArenaMapper* mapper = (Rw17ArenaMapper*)calloc(1, sizeof(Rw17ArenaMapper));
+    if (mapper == NULL)
+    {
+        return false;
+    }
+
+    void* arena = NULL;
+    uint8_t* rwAlias = NULL;
+
+    if (Rw17WaitForDebugger(120 * 1000))
+    {
+        // Re-check immediately before each brk (playport discipline):
+        // liveness can change between the wait and the call - the script
+        // window closing, a stale StikDebug session.
+        if (!Rw17DebuggerAttached())
+        {
+            RW17_LOG("debugger vanished before the prepare brk; no usable JIT memory\n");
+            free(mapper);
+            return false;
+        }
+        RW17_LOG("live debugger confirmed; prepare brk incoming (%zu MiB; the page sweep takes 1-2 min inside the stop)\n",
+                 Rw17ArenaCapacity >> 20);
+        arena = Rw17Jit26PrepareRegion(Rw17ArenaCapacity);
+        if (arena == NULL)
+        {
+            RW17_LOG("prepare brk returned NULL; no usable JIT memory\n");
+            free(mapper);
+            return false;
+        }
+        RW17_LOG("arena granted at %p\n", arena);
+        // Kernel's view of the granted region: extent and protections as
+        // vm_region reports them (the debugserver _M product - on iOS 26
+        // these are known to enumerate submap-backed, sometimes as a single
+        // 16 KiB entry despite the full capacity).
+        {
+            vm_address_t q = (vm_address_t)arena;
+            vm_size_t qSize = 0;
+            vm_region_basic_info_data_64_t qInfo;
+            mach_msg_type_number_t qCnt = VM_REGION_BASIC_INFO_COUNT_64;
+            mach_port_t qObj = MACH_PORT_NULL;
+            if (vm_region_64(mach_task_self(), &q, &qSize, VM_REGION_BASIC_INFO_64,
+                             (vm_region_info_t)&qInfo, &qCnt, &qObj) == KERN_SUCCESS)
+            {
+                if (qObj != MACH_PORT_NULL)
+                    mach_port_deallocate(mach_task_self(), qObj);
+                RW17_LOG("granted region: start=%p size=%llu cur=%x max=%x\n",
+                         (void*)q, (unsigned long long)qSize,
+                         (unsigned)qInfo.protection, (unsigned)qInfo.max_protection);
+            }
+        }
+
+        rwAlias = Rw17MapAliasRW(arena, Rw17ArenaCapacity);
+        if (rwAlias == NULL)
+        {
+            RW17_LOG("RW alias of the arena failed; no usable JIT memory\n");
+            free(mapper);
+            return false;
+        }
+        RW17_LOG("RW alias at %p; detaching before anything executes\n", (void*)rwAlias);
+
+        if (Rw17DebuggerAttached())
+        {
+            Rw17Jit26Detach();
+            RW17_LOG("debugger detached - the blessing keeps the pages executable; the probe below runs unattached\n");
+        }
+        else
+        {
+            // The script died between prepare and detach. Issuing the detach
+            // brk now would be an unserved brk (SIGTRAP death); skip it and
+            // let the probe decide whether the arena outlived its session.
+            RW17_LOG("debugger already gone before the detach brk; probing the arena as-is\n");
+        }
+
+        mapper->rxBase = (uint8_t*)arena;
