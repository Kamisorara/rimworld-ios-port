 {
+#if defined(TARGET_APPLE) && defined(TARGET_ARM64)
+    // Arena mode: the execution view flips between RX (code pages) and RW
+    // (loader-heap data pages that must stay near the code). Single-mapping
+    // mode keeps code pages RWX so writes through the shared view keep working.
