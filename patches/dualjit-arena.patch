+#if defined(TARGET_APPLE) && defined(TARGET_ARM64)
+
+// ---------------------------------------------------------------------------
+// Port17 dual-JIT arena backend (iOS device / macOS CI).
+//
+// iOS does not export pthread_jit_write_protect_np, so a MAP_JIT mapping can
+// never be made writable in-process; on iOS 26+ the kernel additionally
+// refuses to execute self-created RWX mappings even when mmap succeeds.
+// Debugger-granted JIT (StikDebug) works in two steps:
+//   1. while the process is CS_DEBUGGED, a debugserver launch script
+//      (rw17-jit.js) allocates one fixed-size RX arena through the private
+//      "_M<size>,rx" packet, touches every page, and stamps a handshake
+//      header (magic + pid) at offset 0;
+//   2. this backend scans the VM regions for that arena, verifies the
+//      handshake, and creates two aliases of the whole capacity via vm_remap:
+//      an RX view for execution and an RW view for writing. Aliases of
+//      debugger-created pages are not subject to the W^X provenance check.
+// When no arena is found (macOS, a seeded CI arena is still found by scan, or
+// devices where plain RWX execution is permitted) the backend falls back to a
+// self-allocated RWX arena with the same execution probe. If nothing is
+// usable it returns false and the allocator degrades to the legacy path.
+// ---------------------------------------------------------------------------
+
+// 16-byte magic without NUL; the array keeps one extra byte for the C++ rule
+// that forbids truncating string initializers.
+static const char s_rw17ArenaMagic[17] = "RW17-JIT-ARENA1!";
+static const size_t Rw17ArenaMagicLen = sizeof(s_rw17ArenaMagic) - 1; // == 16
+static const size_t Rw17ArenaCapacity = 0x8000000;  // 128 MiB; keep in sync with rw17-jit.js (max safe size: arena must stay within arm64 s ±128 MiB direct-branch reach)
+static const size_t Rw17ArenaHeaderSize = 0x4000;   // page 0 holds the handshake header
+static const size_t Rw17ArenaPageSize = 0x4000;     // arm64 Apple device page size
+
+struct Rw17ArenaMapper
+{
+    uint8_t* rxBase;        // execution view
+    uint8_t* rwBase;        // write view; == rxBase in single-mapping mode
+    size_t capacity;
+    bool singleMapping;     // self-allocated RWX arena: no aliases
+};
+
+static Rw17ArenaMapper* s_rw17Mapper = NULL;
+
+#define RW17_LOG(...) do { fprintf(stderr, "[rw17-arena] " __VA_ARGS__); } while (0)
+
+// Read the 20-byte handshake header (magic + pid) at the start of a region.
+static bool Rw17ReadArenaHeader(void* regionStart, uint32_t* pPid)
+{
+    const size_t headerSize = Rw17ArenaMagicLen + sizeof(uint32_t);
+    uint8_t buffer[Rw17ArenaMagicLen + sizeof(uint32_t)];
+    vm_size_t bytesRead = 0;
+    kern_return_t kr = vm_read_overwrite(mach_task_self(), (vm_address_t)regionStart, headerSize,
+                                         (vm_address_t)buffer, &bytesRead);
+    if (kr != KERN_SUCCESS || bytesRead != headerSize)
+    {
+        return false;
+    }
+    if (memcmp(buffer, s_rw17ArenaMagic, Rw17ArenaMagicLen) != 0)
+    {
+        return false;
+    }
+    uint32_t pid;
+    memcpy(&pid, buffer + Rw17ArenaMagicLen, sizeof(pid));
+    *pPid = pid;
+    return true;
+}
+
+// Walk the VM regions and return the RX arena stamped by the launch script.
+static void* Rw17FindArena()
+{
+    mach_port_t task = mach_task_self();
+    const uint32_t pid = getpid();
+    vm_address_t address = 0;
+    for (;;)
+    {
+        // <mach/mach_vm.h> is blocked in the iOS SDK; vm_region_64 is the same facility.
+        vm_region_basic_info_data_64_t info;
+        mach_msg_type_number_t infoCount = VM_REGION_BASIC_INFO_COUNT_64;
+        mach_port_t objectName = MACH_PORT_NULL;
+        vm_size_t regionSize = 0;
+        kern_return_t kr = vm_region_64(task, &address, &regionSize, VM_REGION_BASIC_INFO_64,
+                                        (vm_region_info_t)&info, &infoCount, &objectName);
+        if (kr != KERN_SUCCESS || regionSize == 0)
+        {
+            break;
+        }
+        if (objectName != MACH_PORT_NULL)
+        {
+            mach_port_deallocate(task, objectName);
+        }
+        if ((info.protection & VM_PROT_EXECUTE) && !(info.protection & VM_PROT_WRITE) &&
+            regionSize >= Rw17ArenaCapacity)
+        {
+            uint32_t pidInHeader = 0;
+            if (Rw17ReadArenaHeader((void*)address, &pidInHeader))
+            {
+                if (pidInHeader == pid)
+                {
+                    RW17_LOG("arena found at %p (%llu bytes, pid %u)\n",
+                             (void*)address, (unsigned long long)regionSize, pidInHeader);
+                    return (void*)address;
+                }
+                RW17_LOG("arena header pid %u does not match this process (%u); skipping\n",
+                         pidInHeader, pid);
+            }
+        }
+        vm_address_t next = address + regionSize;
+        if (next <= address)
+        {
+            break; // wrapped around the address space
+        }
+        address = next;
+    }
+    return NULL;
+}
+
+// Verify the (rw, rx) view pair executes self-written code: two instruction
+// writes through the RW view, each flushed on both views, each called via RX.
+static bool Rw17ProbeExecute(uint8_t* rxView, uint8_t* rwView)
+{
+    const uint32_t kGadget42[2] = { 0x52800540u, 0xD65F03C0u }; // movz w0, #42 ; ret
+    const uint32_t kGadget43Word = 0x52800560u;                 // movz w0, #43
+
+    memcpy(rwView, kGadget42, sizeof(kGadget42));
+    sys_icache_invalidate(rwView, sizeof(kGadget42));
+    sys_icache_invalidate(rxView, sizeof(kGadget42));
+
+    int32_t (*probe)(void) = (int32_t (*)(void))rxView;
+    if (probe() != 42)
+    {
+        return false;
+    }
+
+    memcpy(rwView, &kGadget43Word, sizeof(kGadget43Word));
+    sys_icache_invalidate(rwView, sizeof(kGadget43Word));
+    sys_icache_invalidate(rxView, sizeof(kGadget43Word));
+    return probe() == 43;
+}
+
+// Create an RW alias of [source, source+size) via vm_remap (the aliasing of
+// debugger-created pages bypasses the W^X provenance check that blocks a
+// direct mprotect of the arena itself).
+static uint8_t* Rw17MapAliasRW(void* source, size_t size)
+{
+    vm_address_t alias = 0;
+    vm_prot_t curProtection, maxProtection;
+    kern_return_t kr = vm_remap(mach_task_self(), &alias, size, 0, VM_FLAGS_ANYWHERE,
+                                mach_task_self(), (vm_address_t)source, FALSE,
+                                &curProtection, &maxProtection, VM_INHERIT_NONE);
+    if (kr != KERN_SUCCESS)
+    {
+        return NULL;
+    }
+    if (mprotect((void*)alias, size, PROT_READ | PROT_WRITE) == -1)
+    {
+        vm_deallocate(mach_task_self(), alias, size);
+        return NULL;
+    }
+    return (uint8_t*)alias;
+}
+
+static bool Rw17CreateArenaMapper(void** pHandle, size_t* pMaxExecutableCodeSize)
+{
+    Rw17ArenaMapper* mapper = (Rw17ArenaMapper*)calloc(1, sizeof(Rw17ArenaMapper));
+    if (mapper == NULL)
+    {
+        return false;
+    }
+
+    void* arena = Rw17FindArena();
+    if (arena != NULL)
+    {
+        uint8_t* rwAlias = Rw17MapAliasRW(arena, Rw17ArenaCapacity);
+        if (rwAlias == NULL)
+        {
+            RW17_LOG("RW alias of the arena failed; falling back to a self-allocated arena\n");
+        }
+        else
+        {
+            vm_address_t rxAlias = 0;
+            vm_prot_t curProtection, maxProtection;
+            kern_return_t kr = vm_remap(mach_task_self(), &rxAlias, Rw17ArenaCapacity, 0, VM_FLAGS_ANYWHERE,
+                                        mach_task_self(), (vm_address_t)arena, FALSE,
+                                        &curProtection, &maxProtection, VM_INHERIT_NONE);
+            if (kr != KERN_SUCCESS)
+            {
+                RW17_LOG("RX alias vm_remap failed (kr=%d); falling back to a self-allocated arena\n", kr);
+                munmap(rwAlias, Rw17ArenaCapacity);
+            }
+            else
+            {
+                if (mprotect((void*)rxAlias, Rw17ArenaCapacity, PROT_READ | PROT_EXEC) == -1)
+                {
+                    // The remap normally inherits the source RX protection already.
+                    RW17_LOG("mprotect(RX alias, R|X) failed (errno=%d); continuing with inherited protection\n", errno);
+                }
+
+                mapper->rxBase = (uint8_t*)rxAlias;
+                mapper->rwBase = rwAlias;
+                mapper->singleMapping = false;
+
+                // Probe code writes through the RW view, then the RX->RW->RX
+                // commit flip that loader-heap data pages depend on.
+                if (Rw17ProbeExecute(mapper->rxBase + Rw17ArenaHeaderSize, mapper->rwBase + Rw17ArenaHeaderSize) &&
+                    mprotect(mapper->rxBase + Rw17ArenaHeaderSize, Rw17ArenaPageSize, PROT_READ | PROT_WRITE) == 0 &&
+                    mprotect(mapper->rxBase + Rw17ArenaHeaderSize, Rw17ArenaPageSize, PROT_READ | PROT_EXEC) == 0)
+                {
+                    RW17_LOG("arena adopted: rx=%p rw=%p capacity=%zu (debugger-granted)\n",
+                             (void*)mapper->rxBase, (void*)mapper->rwBase, Rw17ArenaCapacity);
+                    s_rw17Mapper = mapper;
+                    *pHandle = mapper;
+                    *pMaxExecutableCodeSize = Rw17ArenaCapacity - Rw17ArenaHeaderSize;
+                    return true;
+                }
+
+                RW17_LOG("arena views failed the execution/commit probes; falling back\n");
+                munmap((void*)rxAlias, Rw17ArenaCapacity);
+                munmap(rwAlias, Rw17ArenaCapacity);
+                mapper->rxBase = NULL;
+                mapper->rwBase = NULL;
+            }
+        }
+    }
+    else
+    {
+        RW17_LOG("no pre-allocated arena found - run the rw17-jit.js StikDebug launch script first\n");
+    }
+
+    // Fallback: one self-allocated RWX arena. Works on macOS hosts and on
+    // debugger-attached devices whose kernel executes self-written code.
+    void* self = mmap(NULL, Rw17ArenaCapacity, PROT_READ | PROT_WRITE | PROT_EXEC,
+                      MAP_ANON | MAP_PRIVATE, -1, 0);
+    if (self == MAP_FAILED)
+    {
+        RW17_LOG("cannot allocate a plain RWX arena (errno=%d); no usable JIT memory\n", errno);
+        free(mapper);
+        return false;
+    }
+
+    mapper->rxBase = mapper->rwBase = (uint8_t*)self;
+    mapper->singleMapping = true;
+    if (!Rw17ProbeExecute(mapper->rxBase + Rw17ArenaHeaderSize, mapper->rwBase + Rw17ArenaHeaderSize))
+    {
+        RW17_LOG("self-allocated RWX arena does not execute code (code signing?); no usable JIT memory\n");
+        munmap(self, Rw17ArenaCapacity);
+        free(mapper);
+        return false;
+    }
+
+    RW17_LOG("self-allocated RWX arena at %p (single-mapping mode)\n", self);
+    s_rw17Mapper = mapper;
+    *pHandle = mapper;
+    *pMaxExecutableCodeSize = Rw17ArenaCapacity - Rw17ArenaHeaderSize;
+    return true;
+}
+
+#endif // TARGET_APPLE && TARGET_ARM64
+
