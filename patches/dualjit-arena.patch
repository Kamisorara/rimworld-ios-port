 void* VMToOSInterface::ReserveDoubleMappedMemory(void *mapperHandle, size_t offset, size_t size, const void *rangeStart, const void* rangeEnd)
 {
+#if defined(TARGET_APPLE) && defined(TARGET_ARM64)
+    // Arena mode, fd-mapper semantics: every reservation gets a fresh
+    // vm_remap alias of arena[headerSize+offset .. +size). Commit flips that
+    // view IN PLACE between RX and RW - protection changes on remapped
+    // copies of debugger-granted pages are allowed, unlike on the granted
+    // pages themselves - and GetRWMapping hands out short-lived extra
+    // aliases. The interleaved loader heap writes its data through the SAME
+    // VA it reserved, so the reserved view must be the flippable one: a
