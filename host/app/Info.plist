<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- 与可工作的参照包（DR3 Mobile，同设备同 SideStore 能在文件 app 出文件夹）的
	     结构对齐：下面这组是 Xcode 正常出包自带、手工 bundle 容易缺的"正规军零件"。 -->
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon60x60@2x</string>
				<string>AppIcon60x60@3x</string>
			</array>
		</dict>
	</dict>
	<key>CFBundleIcons~ipad</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon76x76@2x~ipad</string>
				<string>AppIcon83.5x83.5@2x~ipad</string>
				<string>AppIcon60x60@2x</string>
			</array>
		</dict>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>DTPlatformName</key>
	<string>iphoneos</string>
	<key>DTPlatformVersion</key>
	<string>26.5</string>
	<key>DTSDKName</key>
	<string>iphoneos26.5</string>
	<key>DTXcode</key>
	<string>2660</string>
	<key>DTXcodeBuild</key>
	<string>17F113</string>
	<key>DTCompiler</key>
	<string>com.apple.compilers.llvm.clang.1_0</string>
	<key>DTPlatformBuild</key>
	<string>23F81a</string>
	<key>DTSDKBuild</key>
	<string>23F81a</string>
	<key>CFBundleDisplayName</key>
	<string>Port17</string>
	<key>CFBundleExecutable</key>
	<string>Port17Host</string>
	<key>CFBundleIdentifier</key>
	<string>com.samilry.port17</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Port17</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.19</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>15.0</string>
	<!-- iPad 原生适配：没有 UIDeviceFamily 时系统按"仅 iPhone"处理，iPad 上进兼容
	     模式（"未适配 iPad"、小窗口）。1=iPhone 2=iPad。 -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad 全向（UIRequiresFullScreen 在，四向是 Apple 对 iPad 的标准要求） -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- 空 dict = 系统默认启动屏：没有它 UIScreen 按老 app 报 320x480 点，
	     原生分辨率（CAMetalLayer 的 drawable 尺寸）就拿不到了。 -->
	<key>UILaunchScreen</key>
	<dict/>
	<!-- 场景生命周期（清单在 = UIKit 走 scene，配置由 AppDelegate 的
	     configurationForConnectingSceneSession 给）：引擎的 iOS 窗口后端
	     （WaylithApplicationDelegate/WaylithSceneDelegate）要求这条路径。 -->
	<key>UIApplicationSceneManifest</key>
	<dict/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- 备用导入通道：文件 app 里点 port17 开头的 zip → 打开方式 → Port17。系统把
	     zip 拷进 Documents/Inbox 再拉起 app，main() 收件后走既有自动安装——Files 里
	     看不看得见 Port17 文件夹都能导入。LSSupportsOpeningFilesInPlace 必须不开：
	     系统才会拷进 Inbox（而不是交一个我们不处理的 in-place URL）。
	     LSHandlerRank=Alternate：不抢占别的 app 的 zip 关联，只出现在打开方式列表里。 -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Port17 game archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
